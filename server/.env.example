# ─── EcoBin server ────────────────────────────────────────────────────────────
PORT=8787

# ThingSpeak — the same channels the dashboard reads.
THINGSPEAK_CHANNELS=
THINGSPEAK_READ_KEYS=
THINGSPEAK_HISTORY=100

# Which field carries what. 0 = the device does not send it.
FIELD_FILL=1
FIELD_WEIGHT=2

THRESHOLD_FULL=80
THRESHOLD_FILLING=50
COLLECTION_DROP_PERCENT=25

# Firebase — shares state with the dashboard. Project id only; the REST API is
# used with the project's current open rules.
FIREBASE_PROJECT_ID=
FIREBASE_WORKSPACE=default

# Where runs start and end.
DEPOT_LAT=26.1445
DEPOT_LNG=91.7362

# Refuse trucks manage roughly 2.5-3 km per litre.
FLEET_KM_PER_LITRE=2.8

# Road routing. Without a key the service falls back to OSRM, which needs none.
ORS_API_KEY=

# How often the engine wakes on its own.
TICK_SECONDS=60

# Send trucks without being asked, once a bin scores this high.
AUTO_DISPATCH=false
AUTO_DISPATCH_MIN_SCORE=70

# Shared secret for the write endpoints. Leave blank to disable the check.
API_TOKEN=
