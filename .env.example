# Optional build-time defaults for the ThingSpeak connection.
# Anything entered under Settings -> ThingSpeak overrides these.

# Numeric channel ID, e.g. 2345678
VITE_THINGSPEAK_CHANNEL_ID=

# Read API key. Leave blank for a public channel.
# Never put a WRITE key here - this file is bundled into the client.
VITE_THINGSPEAK_READ_API_KEY=
