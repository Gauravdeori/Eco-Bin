# ─── EcoBin · ThingSpeak configuration ────────────────────────────────────────
# Copy this file to `.env` and fill in your own channel details.
# Everything here can also be edited at runtime from the Settings page
# (values entered there are stored in localStorage and win over these).

# Comma-separated list of ThingSpeak channel IDs, one per smart bin.
VITE_THINGSPEAK_CHANNELS=

# Read API key. Leave blank for public channels.
# For several private channels use the same order as VITE_THINGSPEAK_CHANNELS:
#   VITE_THINGSPEAK_READ_KEYS=KEY_FOR_CH1,KEY_FOR_CH2
VITE_THINGSPEAK_READ_KEYS=

# How often the dashboard pulls new feeds, in seconds.
# ThingSpeak free tier accepts one write every 15 s; 15-30 s is a good value.
VITE_THINGSPEAK_POLL_SECONDS=15

# How many historical entries to pull per channel (max 8000).
VITE_THINGSPEAK_HISTORY=100

# ─── Field mapping ────────────────────────────────────────────────────────────
# Which ThingSpeak field number carries which measurement.
# 0 means "my device does not send this" — the dashboard shows a dash instead.
# Only fill level and weight are on by default.
VITE_FIELD_FILL=1
VITE_FIELD_WEIGHT=2

# Optional extras — set to a field number once your device publishes them.
VITE_FIELD_BATTERY=0
VITE_FIELD_LAT=0
VITE_FIELD_LNG=0
VITE_FIELD_TEMPERATURE=0
VITE_FIELD_HUMIDITY=0
# Waste category: 0=Dry, 1=Wet, 2=Mixed, 3=Hazardous.
VITE_FIELD_CATEGORY=0

# ─── OpenRouteService (optional) ──────────────────────────────────────────────
# Used for address search in the location picker and for drawing the driving
# route between bins. Map tiles come from OpenStreetMap and need no key.
#
# WARNING: this is a browser app. Anything set here is compiled into the bundle
# and is readable by anyone who opens the site. Use a key you can rotate.
VITE_ORS_API_KEY=

# ─── Map ──────────────────────────────────────────────────────────────────────
# Where the location picker opens before a bin has coordinates.
# Tiles come from OpenStreetMap and need no key.
VITE_MAP_CENTER_LAT=26.1445
VITE_MAP_CENTER_LNG=91.7362
VITE_MAP_CENTER_ZOOM=13

# ─── Thresholds ───────────────────────────────────────────────────────────────
VITE_THRESHOLD_FULL=80
VITE_THRESHOLD_FILLING=50

# ─── n8n dispatch control (optional) ──────────────────────────────────────────
# EcoBin has no server, so n8n cannot push to it. The dashboard polls this URL
# instead: use an n8n Webhook node (GET) ending in "Respond to Webhook", and
# return the bins waiting to be dispatched, e.g.
#   [{ "channelId": "2345678", "action": "DISPATCH", "commandId": "abc-123" }]
# The workflow must send CORS headers for wherever this dashboard is served.
VITE_N8N_WEBHOOK_URL=
VITE_N8N_POLL_SECONDS=10

# ─── Firebase (optional) ──────────────────────────────────────────────────────
# Without these EcoBin keeps every record in this browser's localStorage, which
# is how it has always worked. With them, the fleet, assignments and runs are
# shared: two operators see the same board, and n8n can write a dispatch command
# straight into the page.
#
# This config is not a secret — Firebase publishes it deliberately, it names the
# project rather than authenticating anyone, and it ships inside any client
# bundle. Firestore security rules are what actually protect the data.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Keeps two deployments apart inside one Firebase project.
VITE_FIREBASE_WORKSPACE=default
